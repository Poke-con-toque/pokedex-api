# Copia este fichero como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio.

# Clave para firmar los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Base de datos (SQLite en local; en producción puede ser PostgreSQL)
DATABASE_URL=sqlite:///./pokedex.db

# PokeAPI
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT=10

# Orígenes permitidos para CORS, separados por comas
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
